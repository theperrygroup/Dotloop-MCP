{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageDotloopOAuthTokenStore",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue",
        "secretsmanager:PutSecretValue"
      ],
      "Resource": [
        "__DOTLOOP_APP_OAUTH_TOKEN_SECRET_ARN__"
      ]
    }
  ]
}
