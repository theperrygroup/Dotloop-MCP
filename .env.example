# Dotloop MCP local configuration example.
# Copy values into your shell or a local .env file. Do not commit real secrets.

# Required for local or live Dotloop API calls.
DOTLOOP_ACCESS_TOKEN=

# Optional compatibility alias used by the underlying dotloop package.
DOTLOOP_API_KEY=

# Optional hosted Dotloop app OAuth. This is the preferred hosted path because
# the connector can complete Dotloop OAuth and store refreshable token state.
DOTLOOP_APP_OAUTH_ENABLED=0
DOTLOOP_API_CLIENT_ID=
DOTLOOP_API_SECRET=
DOTLOOP_APP_OAUTH_AUTHORIZE_URL=https://auth.dotloop.com/oauth/authorize
DOTLOOP_APP_OAUTH_TOKEN_URL=https://auth.dotloop.com/oauth/token
DOTLOOP_APP_OAUTH_REDIRECT_URL=https://tpgstats.com/agents/dotloop/callback
DOTLOOP_APP_OAUTH_TOKEN_SECRET_ARN=
DOTLOOP_APP_OAUTH_TOKEN_REFRESH_LEEWAY_SECONDS=300
DOTLOOP_APP_OAUTH_TOKEN_REQUEST_TIMEOUT_SECONDS=15

# Optional API/runtime overrides.
DOTLOOP_BASE_URL=https://api-gateway.dotloop.com/public/v2
DOTLOOP_TIMEOUT_SECONDS=30
DOTLOOP_TRANSPORT=stdio
DOTLOOP_HOST=127.0.0.1
DOTLOOP_PORT=8000
DOTLOOP_STREAMABLE_HTTP_PATH=/mcp
DOTLOOP_LOG_LEVEL=INFO

# Optional deterministic fixture mode for Claude/ChatGPT battle testing.
# This mode is incompatible with DOTLOOP_RUN_LIVE_TESTS=1 and never calls
# Dotloop's API.
DOTLOOP_BATTLE_FIXTURE_MODE=0
DOTLOOP_BATTLE_RECORD_PATH=tmp/ai-battle/latest/mcp_calls.jsonl

# Optional inbound MCP URL OAuth for streamable HTTP.
# Stdio transport continues to use local environment credentials.
DOTLOOP_MCP_AUTH_ENABLED=0
DOTLOOP_MCP_AUTH_ISSUER_URL=
DOTLOOP_MCP_AUTH_RESOURCE_SERVER_URL=
DOTLOOP_MCP_AUTH_JWKS_URL=
DOTLOOP_MCP_AUTH_REQUIRED_SCOPES=dotloop:read
DOTLOOP_MCP_AUTH_AUDIENCE=
DOTLOOP_MCP_AUTH_ALLOWED_ALGORITHMS=RS256
DOTLOOP_MCP_AUTH_TOKEN_LEEWAY_SECONDS=30
DOTLOOP_MCP_AUTH_JWKS_CACHE_SECONDS=300

# Optional built-in authorization-server routes for hosted staging.
# Public consent is disabled for app-OAuth hosted deployments because Dotloop
# OAuth becomes the consent boundary.
DOTLOOP_MCP_HOSTED_OAUTH_ENABLED=0
DOTLOOP_MCP_HOSTED_OAUTH_PUBLIC_CONSENT_ENABLED=0
DOTLOOP_MCP_HOSTED_OAUTH_AUTHORIZATION_CODE_SECONDS=300
DOTLOOP_MCP_HOSTED_OAUTH_ACCESS_TOKEN_SECONDS=3600
DOTLOOP_MCP_HOSTED_OAUTH_REFRESH_TOKEN_SECONDS=2592000

# Optional live read-only smoke gates.
DOTLOOP_RUN_LIVE_TESTS=0
DOTLOOP_LIVE_PROFILE_ID=
DOTLOOP_LIVE_LOOP_ID=
DOTLOOP_LIVE_DOCUMENT_ID=
